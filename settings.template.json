{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "skillOverrides": {
    "anywidget-generator": "off",
    "agent-browser": "off",
    "browser-use": "off",
    "check": "off",
    "gemini-api-dev": "off",
    "gemini-interactions-api": "off",
    "grep-code-search": "off",
    "process-pdf": "off",
    "qmd": "off",
    "scanning-code": "off",
    "xurl": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.claude/hooks/rm_rf_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ${HOME}/.claude/hooks/bash_command_validator.py"
          },
          {
            "type": "command",
            "command": "python3 ${HOME}/.claude/hooks/bash_risk_judge.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.claude/hooks/secrets_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.claude/hooks/file_protection.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${HOME}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "agent-browser@agent-browser": false,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "discord@claude-plugins-official": false,
    "astral@astral-sh": true,
    "obsidian@obsidian-skills": true,
    "codex@openai-codex": true,
    "claude-md-management@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": false,
    "qmd@qmd": false,
    "lua-lsp@claude-plugins-official": false,
    "chrome-devtools-mcp@chrome-devtools-plugins": false,
    "huggingface-skills@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": false,
    "vercel@claude-plugins-official": true,
    "pydantic@pydantic-skills": true
  },
  "extraKnownMarketplaces": {
    "qmd": {
      "source": {
        "source": "github",
        "repo": "tobi/qmd"
      }
    },
    "huggingface-skills": {
      "source": {
        "source": "github",
        "repo": "huggingface/skills"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "pydantic-skills": {
      "source": {
        "source": "github",
        "repo": "pydantic/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "marketplaces": [
    {
      "name": "claude-code-local-plugins",
      "source": "${HOME}/Develop/claude-code-rules/"
    }
  ],
  "plugins": []
}
